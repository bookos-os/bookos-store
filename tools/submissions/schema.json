{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookOS Store App Submission",
  "description": "Manifiesto de envío de aplicaciones comunitarias para BookOS Store",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pkg",
    "label",
    "subtitle",
    "description",
    "category",
    "author",
    "contact_email",
    "license",
    "version",
    "notes",
    "source",
    "urls",
    "media",
    "privacy",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pkg": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+._-]{1,62}$"
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "label_en": {
      "type": "string",
      "maxLength": 40
    },
    "subtitle": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 15,
      "maxLength": 2000
    },
    "description_en": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "enum": [
        "Productividad",
        "Utilidades",
        "Internet",
        "Multimedia",
        "Oficina",
        "Gráficos",
        "Desarrollo",
        "Educación",
        "Juegos",
        "Ciencia",
        "Sistema"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "maxLength": 160
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){1,3}(-[0-9A-Za-z.]+)?$",
      "maxLength": 32
    },
    "notes": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "notes_en": {
      "type": "string",
      "maxLength": 2000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_url", "commit", "build_system"],
      "properties": {
        "git_url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 256
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": "string",
          "maxLength": 64
        },
        "build_system": {
          "type": "string",
          "enum": ["tauri", "cargo", "meson", "cmake", "make", "python", "node", "custom"]
        },
        "build_subdir": {
          "type": "string",
          "maxLength": 128
        },
        "binary_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]{1,62}$"
        }
      }
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "support", "privacy"],
      "properties": {
        "homepage": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 256
        },
        "support": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 256
        },
        "privacy": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 256
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon_path", "screenshots"],
      "properties": {
        "icon_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collects_data", "tracking", "network", "data_types"],
      "properties": {
        "collects_data": {
          "type": "boolean"
        },
        "tracking": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "data_types": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 48
          }
        },
        "policy_url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 256
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_account", "demo_notes", "permissions_rationale"],
      "properties": {
        "requires_account": {
          "type": "boolean"
        },
        "demo_notes": {
          "type": "string",
          "maxLength": 1000
        },
        "permissions_rationale": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
